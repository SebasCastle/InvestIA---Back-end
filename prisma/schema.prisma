generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetType {
  STOCK
  ETF
  CRYPTO
  FOREX
  OTHER
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
  DEPOSIT
  WITHDRAWAL
}

enum AlertKind {
  PRICE_ABOVE
  PRICE_BELOW
  RETURN_ABOVE
  RETURN_BELOW
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique
  passwordHash String
  firstName    String
  lastName     String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  portfolios   Portfolio[]
  alerts       Alert[]

  @@map("users")
}

model Portfolio {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  currency     String
  userId       String        @db.Uuid
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  positions    Position[]
  transactions Transaction[]
  alerts       Alert[]

  @@index([userId])
  @@map("portfolios")
}

model Asset {
  id           String        @id @default(uuid()) @db.Uuid
  symbol       String
  name         String
  type         AssetType
  exchange     String
  currency     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  positions    Position[]
  transactions Transaction[]

  @@unique([symbol])
  @@index([type])
  @@map("assets")
}

model Position {
  id          String    @id @default(uuid()) @db.Uuid
  portfolioId String    @db.Uuid
  assetId     String    @db.Uuid
  quantity    Decimal   @db.Decimal(18, 8)
  averageCost Decimal   @db.Decimal(18, 8)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([portfolioId, assetId])
  @@index([assetId])
  @@map("positions")
}

model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  portfolioId String          @db.Uuid
  assetId     String?         @db.Uuid
  type        TransactionType
  quantity    Decimal         @db.Decimal(18, 8)
  price       Decimal         @db.Decimal(18, 8)
  fees        Decimal         @default(0) @db.Decimal(18, 8)
  currency    String
  executedAt  DateTime
  createdAt   DateTime        @default(now())
  portfolio   Portfolio       @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset       Asset?          @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([portfolioId])
  @@index([assetId])
  @@index([type])
  @@index([executedAt])
  @@map("transactions")
}

model Alert {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String     @db.Uuid
  portfolioId     String?    @db.Uuid
  symbol          String?
  kind            AlertKind
  threshold       Decimal    @db.Decimal(18, 8)
  enabled         Boolean    @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio       Portfolio? @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled])
  @@map("alerts")
}
